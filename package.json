{
  "name": "fpv-lab-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FPV drone builder, simulator and tuner. Runs on PC (web) and Android (Capacitor APK).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "cap:sync": "npm run build && cap sync",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs",
    "android:run": "npm run android:sync && cap run android",
    "icons": "node scripts/gen-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
